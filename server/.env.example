# ASEP Server Configuration
PORT=5001
NODE_ENV=development

# Database URIs
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
MOCK_LLM=false

# Seed realistic demo data (leads, proposals, market history) on boot.
# Set to true for showcases/judge demos; keep false in production.
SEED_DEMO_DATA=false

# Security
JWT_SECRET=your_jwt_signing_secret_here
JWT_EXPIRES_IN=24h

# Client URL (for CORS alignment)
CLIENT_URL=http://localhost:5173

# Adaptive pricing: how often the price multipliers are re-tuned (hours).
# Lower it (e.g. 1) in dev to watch prices adapt quickly.
PRICING_REFRESH_HOURS=24

# Market scanner: how often to check configured competitor pricing pages (hours).
MARKET_SCAN_HOURS=24

# Public base URL for generated links (e.g. proposal PDF downloads).
# Set this to your deployed API URL in production, e.g. https://api.example.com
PUBLIC_BASE_URL=http://localhost:5001

# Transactional Email SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@asep.local
